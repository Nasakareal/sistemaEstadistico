<IfModule php7_module>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

<IfModule php_module>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

ServerSignature Off

<IfModule mod_headers.c>
    Header always unset X-Powered-By

    # PHP-FPM y mod_headers conservan tablas separadas de encabezados. Limpiar
    # la tabla "onsuccess" antes de fijar el valor evita duplicados en la salida.
    Header onsuccess unset X-Content-Type-Options
    Header onsuccess unset X-Frame-Options
    Header onsuccess unset Referrer-Policy
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Rechaza archivos ocultos y rutas de herramientas que buscan los escaneres.
    # Se conserva .well-known para validaciones de certificados TLS.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    # Este .htaccess vive dentro de public/: /vendor contiene los assets
    # publicos de AdminLTE y sus plugins. Bloquearlo deja la aplicacion sin CSS.
    # El vendor de Composer esta fuera de este document root y no queda expuesto.
    RewriteRule ^(?:storage/logs|bootstrap/cache|config|database|tests)(?:/|$) - [F,L,NC]
    # Detiene sondeos automatizados conocidos antes de arrancar PHP/Laravel.
    RewriteRule ^(?:wp-admin(?:\.php)?|wp-login\.php|wp-content|xmlrpc\.php|phpmyadmin|pma|server-status|cgi-bin|actuator|userfiles)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:config|shell)\.php(?:\.(?:bak|old|save|swp|txt))?$ - [F,L,NC]

    # Las fotos de personal se sirven por una ruta autenticada, no por /storage.
    RewriteRule ^storage/personals/fotos/ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

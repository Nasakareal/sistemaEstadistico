# Copiar como .env junto a index.js en el servidor que ejecutará Node.
# En producción Laravel debe estar publicado con la carpeta public como raíz web,
# por lo que normalmente la URL termina directamente en /api (sin /public).
LARAVEL_API_BASE_URL=https://TU-DOMINIO-PUBLICO.example/api
WHATSAPP_WEB_READER_SECRET=REEMPLAZAR_CON_EL_MISMO_SECRETO_DE_LARAVEL
WHATSAPP_WEB_READER_GROUP_IDS=120363424100430316@g.us
WHATSAPP_WEB_READER_CLIENT_ID=sistema-estadistico-reader-produccion
WHATSAPP_WEB_READER_HEADLESS=true

# Sólo si Puppeteer no encuentra Chrome/Chromium en el servidor:
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
